{
  "id": "hello-world",
  "name": "Hello World 示例插件",
  "version": "1.0.0",
  "description": "一个简单的示例插件，展示插件开发的基本方法",
  "author": "Bilibili 直播助手团队",
  "main": "index.js",
  "minAppVersion": "1.0.0",
  "permissions": ["danmaku", "gift", "config"],
  "configSchema": {
    "greeting": {
      "type": "string",
      "default": "你好！欢迎来到直播间！",
      "description": "欢迎语"
    },
    "autoReply": {
      "type": "boolean",
      "default": true,
      "description": "是否自动回复"
    }
  }
}
