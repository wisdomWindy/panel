{
  "name": "bilibili-live-tool-monorepo",
  "version": "0.1.1",
  "description": "Bilibili 直播助手 Monorepo",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "dev": "pnpm --filter @monorepo/bilibili-live-tool dev",
    "build": "pnpm --filter @monorepo/bilibili-live-tool build",
    "lint": "pnpm --filter @monorepo/bilibili-live-tool lint",
    "lint:check": "pnpm --filter @monorepo/bilibili-live-tool lint:check",
    "type-check": "pnpm --filter @monorepo/bilibili-live-tool type-check",
    "homepage:dev": "pnpm --filter @monorepo/bilibili-live-tool-homepage dev",
    "homepage:build": "pnpm --filter @monorepo/bilibili-live-tool-homepage build",
    "homepage:preview": "pnpm --filter @monorepo/bilibili-live-tool-homepage preview"
  }
}
