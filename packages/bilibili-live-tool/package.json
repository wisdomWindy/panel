{
  "name": "@monorepo/bilibili-live-tool",
  "version": "0.1.0",
  "description": "Bilibili 直播助手 - 智能弹幕与互动工具",
  "main": "dist/main/index.js",
  "author": "Your Name",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev.js",
    "build": "node scripts/build.js",
    "build:vite": "vite build",
    "build:app": "vite build && electron-builder",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue src --fix",
    "lint:check": "eslint --ext .js,.ts,.vue src",
    "lint:style": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "type-check": "tsc --noEmit -p tsconfig.eslint.json",
    "format": "prettier --write src/"
  },
  "build": {
    "appId": "com.bilibili.live-tool",
    "productName": "Bilibili 直播助手",
    "executableName": "start",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*"
    ],
    "electronDist": "node_modules/electron/dist",
    "mac": {
      "target": "dmg",
      "icon": "public/icon.icns"
    },
    "win": {
      "target": "nsis",
      "icon": "public/icon.ico"
    },
    "linux": {
      "target": "AppImage",
      "icon": "public/icon.png"
    }
  },
  "dependencies": {
    "@element-plus/icons-vue": "catalog:",
    "@types/lodash": "catalog:",
    "@types/three": "catalog:",
    "@vueuse/core": "catalog:",
    "axios": "catalog:",
    "crypto-js": "catalog:",
    "dayjs": "catalog:",
    "echarts": "catalog:",
    "electron-store": "catalog:",
    "element-plus": "catalog:",
    "lodash": "catalog:",
    "pako": "catalog:",
    "pinia": "catalog:",
    "three": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:",
    "winston": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@types/node": "catalog:",
    "@types/pako": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@vue/typescript-plugin": "catalog:",
    "autoprefixer": "catalog:",
    "electron": "catalog:",
    "electron-builder": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vite-plugin-electron": "catalog:",
    "vite-plugin-electron-renderer": "catalog:"
  }
}
