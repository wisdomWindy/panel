{
  "name": "@monorepo/bilibili-live-tool",
  "version": "0.4.7",
  "description": "biliLiveHelper - 智能弹幕与互动工具",
  "author": "",
  "license": "MIT",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm dev:free",
    "dev:free": "tauri dev --config src-tauri/tauri.free.conf.json",
    "dev:member": "tauri dev --config src-tauri/tauri.member.conf.json",
    "dev:web": "vite --mode free --host 127.0.0.1",
    "build": "pnpm build:free",
    "build:free": "tauri build --config src-tauri/tauri.free.conf.json",
    "build:member": "tauri build --config src-tauri/tauri.member.conf.json",
    "build:web": "pnpm build:web:free",
    "build:web:free": "vite build --mode free",
    "build:web:member": "vite build --mode member",
    "build:vite": "vite build",
    "build:renderer": "vite build",
    "preview": "vite preview",
    "lint": "eslint --ext .js,.ts,.vue src --fix",
    "lint:check": "eslint --ext .js,.ts,.vue src",
    "lint:style": "stylelint \"src/**/*.{vue,scss,css}\" --fix",
    "type-check": "tsc --noEmit -p tsconfig.eslint.json",
    "test:platform": "vitest run src/renderer/platform/desktop",
    "test:live-data": "vitest run --mode free src/renderer/modules/live-data src/renderer/composables/useLiveDataRuntime.test.ts src/renderer/stores/live-data",
    "test:release": "node --test scripts/*.node-test.mjs",
    "format": "prettier --write src/",
    "tauri": "tauri"
  },
  "dependencies": {
    "@element-plus/icons-vue": "catalog:",
    "@tauri-apps/api": "^2.11.1",
    "echarts": "catalog:",
    "element-plus": "catalog:",
    "pinia": "catalog:",
    "vue": "catalog:",
    "vue-i18n": "catalog:",
    "vue-router": "catalog:"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "catalog:",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "catalog:",
    "@typescript-eslint/eslint-plugin": "catalog:",
    "@typescript-eslint/parser": "catalog:",
    "@vitejs/plugin-vue": "catalog:",
    "@vue/tsconfig": "catalog:",
    "@vue/typescript-plugin": "catalog:",
    "autoprefixer": "catalog:",
    "eslint": "catalog:",
    "eslint-plugin-vue": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-auto-import": "catalog:",
    "unplugin-vue-components": "catalog:",
    "vite": "catalog:",
    "vitest": "^2.1.9"
  }
}
